@{
    ViewData["Title"] = "Login";
}

<style>
   

    .k-form-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .k-form-buttons>.k-button {
        width: 100%;
        margin: 0;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-sm-5">

                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 bg-primary bg-opacity-10 rounded-3 mb-3">
                        <span class="k-icon k-i-comment k-color-primary" style="font-size: 32px;"></span>
                    </div>
                    <h2 class="h4 fw-bold" style="color: rgb(77, 75, 159);">Welcome Back</h2>
                    
                </div>

                <form id="loginForm"></form>

                <div id="auth-message" class="mt-3"></div>

              
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#loginForm").kendoForm({
                layout: "vertical",
                validatable: {
                    validateOnBlur: true,
                    errorTemplate: "<span class='k-text-error small d-block mt-1'>#:message#</span>"
                },
                items: [
                    {
                        field: "c_Email",
                        label: "Email",
                        editor: function (container, options) {
                            $('<input type="email" name="' + options.field + '" required />')
                                .appendTo(container)
                                .kendoTextBox({
                                    placeholder: "example@email.com",
                                    fillMode: "outline", 
                                    size: "large",
                                    rounded: "medium"
                                });
                        },
                        validation: { required: { message: "Email is required" } }
                    },
                    {
                        field: "c_Password",
                        label: "Password",
                        editor: function (container, options) {
                            $('<input type="password" name="' + options.field + '" required />')
                                .appendTo(container)
                                .kendoTextBox({
                                    placeholder: "••••••••",
                                    fillMode: "outline",
                                    size: "large",
                                    rounded: "medium"
                                });
                        },
                        validation: { required: { message: "Password is required" } }
                    }
                ],
                buttonsTemplate:
                    '<button type="submit" class="k-button k-button-lg k-rounded-md k-button-solid-primary">Sign In</button>' +
                    '<button type="reset" class="k-button k-button-md k-rounded-md k-button-flat-base">Clear</button>',
                submit: function (e) {
                    e.preventDefault();
                    var $msg = $("#auth-message");
                    $msg.fadeOut();

                    $.ajax({
                        url: '@Url.Action("Login", "User")',
                        method: "POST",
                        data: {
                            email: e.model.c_Email,
                            password: e.model.c_Password
                        },
                        success: function (response) {
                            if (response.success) {
                                window.location.href = '@Url.Action("Index", "Chat")';
                            } else {
                                $msg.html("<div class='alert alert-danger py-2 small text-center'>" + response.message + "</div>").fadeIn();
                            }
                        },
                        error: function () {
                            $msg.html("<div class='alert alert-danger py-2 small text-center'>Connection failed.</div>").fadeIn();
                        }
                    });
                }
            });
        });
    </script>
}